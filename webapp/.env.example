# Copy this file to .env (gitignored) and fill in your Supabase project's
# values — Project Settings → API in the Supabase dashboard.
#
# The anon/public key is safe to ship in the browser bundle: it can only
# do what the database's Row Level Security policies (supabase/schema.sql)
# allow, which for the gated tables here is "nothing unless logged in."
# NEVER put the service_role key here — that one is for
# scripts/seed_supabase.py only, passed as an environment variable, never
# committed or bundled.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
